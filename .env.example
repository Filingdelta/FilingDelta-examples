# Copy to .env and export it yourself:
#   set -a; . ./.env; set +a
# The scripts read process.env and do not load this file.
# Never commit a real key.

EVM_PRIVATE_KEY=
CONFIRM_PAY=no
MAX_USD=0.10
WATCH_TICKERS=AMD,NVDA,TSM
FILINGDELTA_BASE=https://filingdelta.xyz

